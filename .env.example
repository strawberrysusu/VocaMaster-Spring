# 복사해서 .env를 만들고 값을 채운다:  cp .env.example .env
# .env는 .gitignore에 있어 git에 절대 안 올라감 — 이 예시 파일에는 진짜 값 금지

# 앱을 노출할 호스트 포트 (서버는 8080, 로컬 리허설은 8083 추천 — 8080은 개발 서버가 씀)
APP_PORT=8080

# JWT 서명 시크릿 — 생성:  openssl rand -base64 48
# 레포에 있는 dev/test 값을 넣으면 ProdSafetyGuard가 부팅을 거부한다 (ADR-042)
JWT_SECRET=

# 앱 전용 DB 계정(vocamaster)의 비밀번호 — MySQL 컨테이너가 첫 기동 때 이 계정을 만든다
DB_PASSWORD=

# MySQL root 비밀번호 (관리·백업용 — 앱은 안 씀)
MYSQL_ROOT_PASSWORD=
